{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "allow-ssh-test-connection",
    "allow-ssh-exec",
    "allow-ssh-pty-open",
    "allow-ssh-pty-write",
    "allow-ssh-pty-resize",
    "allow-ssh-pty-close",
    "allow-monitor-snapshot",
    "allow-sftp-list-dir",
    "allow-net-ping",
    "allow-net-dns-lookup",
    "allow-net-arp-table",
    "allow-net-port-check",
    "allow-net-traceroute",
    "allow-discovery-default-cidr",
    "allow-discovery-scan",
    "allow-local-home-dir",
    "allow-local-list-dir",
    "allow-share-create",
    "allow-share-list",
    "allow-share-revoke",
    "allow-share-lan-base-url",
    "allow-auth-account-exists",
    "allow-auth-list-usernames",
    "allow-auth-create-account",
    "allow-auth-verify-password",
    "allow-auth-current-user",
    "allow-auth-logout",
    "allow-auth-biometric-available",
    "allow-auth-biometric-unlock",
    "allow-known-hosts-get",
    "allow-known-hosts-forget",
    "allow-vault-set-password",
    "allow-vault-get-password",
    "allow-vault-delete-password",
    "allow-sftp-upload",
    "allow-sftp-download",
    "allow-serial-list-ports",
    "allow-serial-open",
    "allow-serial-write",
    "allow-serial-close",
    "allow-db-list-devices",
    "allow-db-save-device",
    "allow-db-delete-device",
    "allow-db-import-devices",
    "allow-db-export-devices",
    "allow-db-list-groups",
    "allow-db-create-group",
    "allow-db-delete-group",
    "allow-db-list-audit-log",
    "allow-task-create",
    "allow-task-list",
    "allow-task-run",
    "allow-task-retry-failed",
    "allow-mdns-browse",
    "allow-wol-send"
  ]
}
